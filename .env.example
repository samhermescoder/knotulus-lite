# Knotulus Lite — configuration
# Copy to .env and fill in. Mock mode needs NOTHING; it runs with zero credentials.

# --- Model backend ---
# "false" (default): run the whole fleet with a deterministic local mock.
# "true": use real Gemini 3.5 Flash via Vertex AI + Application Default Credentials.
#         No API key required — ADC is the recommended auth method.
ENABLE_GEMINI=false

# --- Google Cloud (only needed when ENABLE_GEMINI=true) ---
# Authenticate once with:  gcloud auth application-default login
# (Active path for knotulus-lite. ADC is account-level, but the app pins
#  GOOGLE_CLOUD_PROJECT below, so Vertex only ever calls THIS project.)
# Alternative (no GCP): set GOOGLE_API_KEY (Gemini Developer API, free) — but
#   geo-restricted; unavailable from HK, so Vertex+ADC is the path we use.
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=knotulus-lite
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-3.5-flash

# --- Optional Firestore mirror (satisfies GCP infra requirement alongside Cloud Run) ---
ENABLE_FIRESTORE=false

# --- App ---
PORT=8080
KNOTULUS_ROOT=.
